# Supabase (crie um projeto grátis em supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Mercado Pago (Suas credenciais -> Painel do Desenvolvedor -> Credenciais de produção)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx

# URL pública do site (usada nos redirects de pagamento e no webhook)
# Em produção, coloque a URL da Vercel. Em dev local, use ngrok se quiser testar o webhook.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Login do dashboard (troque por uma senha forte)
DASHBOARD_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
